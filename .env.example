# Example Environment Variables
# Copy this file to .env and fill in your actual values

GROQ_API_KEY=your-groq-api-key-here
# (Optional) Override the Groq model name used by the app. Example: llama-3.3-70b-versatile
GROQ_MODEL=meta-llama/llama-prompt-guard-2-86m
# Optional Gemini config
# Add your Gemini API key to .env as GEMINI_API_KEY to enable Gemini model usage
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-2.5-flash-lite

# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development

# Secret Key (Generate a random string for security)
SECRET_KEY=your-secret-key-here

# Firebase Configuration
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json
