# Example Environment Variables
# Copy this file to .env and fill in your actual values

OPENAI_API_KEY=your-openai-api-key-here
OPENAI_ANALYSIS_MODEL=gpt-4o-mini
OPENAI_RESPONSE_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Optional Gemini config
# Add your Gemini API key to .env as GEMINI_API_KEY to enable Gemini model usage
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-2.5-flash-lite

# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development

# Secret Key (Generate a random string for security)
SECRET_KEY=your-secret-key-here

# MySQL (Laragon defaults: user=root, blank password)
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/menti_chatbot?charset=utf8mb4

# Google OAuth 2.0 credentials from Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/auth/google/callback
GOOGLE_PROVIDER_REDIRECT_URI=http://127.0.0.1:5000/providers/auth/google/callback

# Optional: first administrator, promoted after verified Google sign-in
ADMIN_EMAIL=

# Set true behind HTTPS on Hostinger
SESSION_COOKIE_SECURE=false
TURN_SERVER_URL=turn:your-turn-server.example.com:3478
TURN_SERVER_USERNAME=
TURN_SERVER_CREDENTIAL=
